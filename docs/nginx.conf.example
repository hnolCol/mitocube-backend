# Example nginx reverse-proxy configuration for mitocube-backend.
#
# REQUIRED for login rate limiting: the backend resolves the real client
# IP from the X-Forwarded-For header, but only when the request arrives
# from a trusted proxy (TRUSTED_PROXY_IPS, default 127.0.0.1,::1).
# The proxy_set_header lines below are what make that work.
#
# Without "proxy_set_header X-Forwarded-For ..." every user appears to
# the backend as the nginx IP, and all users share a single login
# rate-limit budget.

server {
    listen 80;
    server_name mitocube.age.mpg.de;

    location / {
        proxy_pass http://127.0.0.1:8000;

        # --- REQUIRED: pass the original client IP to the backend ---
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header Host $host;

        # --- recommended for the token endpoints and large payloads ---
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 20m;
        proxy_read_timeout 120s;
    }
}
