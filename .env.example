# MitoCube Backend Configuration
# ============================================
# 
# INSTRUCTIONS:
# 1. Copy this file to .env
#    cp .env.example .env
# 
# 2. Fill in all REQUIRED values (marked with # REQUIRED)
# 
# 3. For production, encrypt your .env file:
#    - Generate encryption key: python -c "from config.secrets.encryption import EnvFileEncryptor; print(EnvFileEncryptor().get_key())"
#    - Store the key securely (password manager, /etc/mitocube/encryption_key)
#    - Encrypt: python -c "from config.secrets.encryption import EnvFileEncryptor; e = EnvFileEncryptor(input('Key: ')); e.encrypt_file('.env')"
#    - Use deploy.py: export ENCRYPTION_KEY="your-key" && python deploy.py
#
# 4. Generate secure secrets:
#    python -m config.secrets.generator --all
#
# ============================================

# ============================================
# REQUIRED SECRETS - NO DEFAULTS AVAILABLE
# ============================================

# JWT Configuration
# Generate with: python -m config.secrets.generator --jwt
JWT_KEY=your-32-character-or-longer-jwt-signing-key-here
JWT_SHARE_KEY=your-32-character-or-longer-jwt-share-key-here
JWT_ALGORITHM=HS256

# Database Passwords
# Generate with: python -m config.secrets.generator --password
NEO4J_PASSWORD=your-neo4j-database-password-here
MONGO_PASSWORD=your-mongodb-password-here

# Email Configuration
MAIL_USERNAME=your-email@domain.com
MAIL_PASSWORD=your-email-password-here

# Share Token Password
# Generate with: python -m config.secrets.generator --password
SHARE_TOKEN_PW=your-share-token-password-here

# MFA Encryption Key
# Generate with: python -m config.secrets.generator --api-key
MFA_ENCRYPTION_KEY=your-mfa-encryption-key-here

# ============================================
# OPTIONAL SETTINGS (with defaults)
# ============================================

# Database Configuration
DB_HANDLER=neo4j
DB_URI=bolt://localhost:7687
DB_USER=neo4j
DB_NAME=neo4j

# Email Server Configuration
MAIL_SERVER=mail.ox.gwdg.de
MAIL_PORT=587
MAIL_USE_TLS_SSL=False
MAIL_START_TLS=True
MAIL_DEFAULT_SENDER=mitocube@age.mpg.de
MAIL_USE_CRENDENTIALS=True
MAIL_VALIDATE_CERTS=False
MAIL_FROM_NAME=MitoCube Support

# Token Expiry
EXPIRES_AFTER_HOURS=48
EXPIRES_AFTER_MINUTES=15

# Share Token Expiry (days)
SHARE_EXPIRES_AFTER_HOURS=2880  # 120 days

# MFA Settings
MFA_MONGO_DB_NAME=mfa_db
MFA_MAX_ATTEMPTS=5
MFA_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=10
TRUSTED_PROXY_IPS=127.0.0.1,::1

# AI Agent MongoDB Configuration
AGENT_MONGO_DB_NAME=mongodb
MFA_MONGO_DB_NAME=auth
MONGO_USER=ai
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_AUTH_DB=admin

# Application Settings
APP_NAME=MitoCube
VERSION=0.1
LEAD_CONTACT=h.nolte@age.mpg.de
DESCRIPTION=MitoCube offers protein-centric searches to explore the expression of a protein in all acquired proteomic datasets.
ALLOWED_EMAIL_DOMAINS=["@age.mpg.de"]

# File Paths (adjust based on your setup)
ATTRIBUTE_FILE=/path/to/resources/attributes/attributes.json
FRONTEND_BUILD=/path/to/frontend/build
FRONTEND_BUILD_ASSETS=/path/to/frontend/build/assets

# ============================================
# DEVELOPMENT SETTINGS
# ============================================

# Set to true for development mode (auto-reload)
MITOCUBE_DEV=true

# Uvicorn settings for development
UVICORN_HOST=0.0.0.0
UVICORN_PORT=5002
UVICORN_WORKERS=1

# ============================================
# SECRET REQUIREMENTS
# ============================================
# 
# All REQUIRED secrets must meet the following:
# 
# JWT_KEY, JWT_SHARE_KEY:
#   - Minimum 32 characters
#   - Random, URL-safe string
# 
# NEO4J_PASSWORD, MONGO_PASSWORD, MAIL_PASSWORD, SHARE_TOKEN_PW:
#   - Minimum 12 characters
#   - At least one uppercase letter (A-Z)
#   - At least one lowercase letter (a-z)
#   - At least one digit (0-9)
#   - At least one special character (!@#$%^&*(),.?":{}|<>) 
# 
# MFA_ENCRYPTION_KEY:
#   - Minimum 32 characters
#   - Random string
#
# Use the generator to create compliant secrets:
# python -m config.secrets.generator --all
